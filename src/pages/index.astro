---
import "../styles/global.css";
import { ArrowDown, ArrowUpRight, GitBranch, Mail, Video } from "lucide-react";
import ActivityPanel from "../components/ActivityPanel.astro";
import BottomDock from "../components/BottomDock.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillsTools from "../components/SkillsTools.astro";
import { fetchGitHubContributionWeeks, fetchGitHubSignals } from "../lib/github";
import { projects } from "../data/portfolio";

interface WakaTimeItem {
  name: string;
  percent: number;
  text: string;
}

interface WakaTimeStats {
  human_readable_range: string;
  human_readable_total: string;
  human_readable_daily_average: string;
  days_minus_holidays: number;
  best_day: { date: string; text: string } | null;
  languages: WakaTimeItem[];
  editors: WakaTimeItem[];
  operating_systems: WakaTimeItem[];
}

interface WakaTimeAllTimeStats {
  text: string;
  daily_average: number;
  range: { start_date: string };
}

interface WakaTimeResponse {
  data?: WakaTimeStats;
}

interface WakaTimeAllTimeResponse {
  data?: WakaTimeAllTimeStats;
}

const githubUsername = import.meta.env.GITHUB_USERNAME?.trim() || "crazygiscool";
const githubProfileUrl = `https://github.com/${encodeURIComponent(githubUsername)}`;
const avatarUrl = `https://github.com/${encodeURIComponent(githubUsername)}.png?size=176`;
const githubSignals = await fetchGitHubSignals();
const githubLanguages = githubSignals.languages.length
  ? githubSignals.languages
  : ["Java", "Rust", "Dart", "TypeScript", "Go"];
const githubTools = githubSignals.tools.length
  ? githubSignals.tools
  : ["Git", "Linux", "Neovim", "Minecraft", "Flutter"];

const contributionWeeks = await fetchGitHubContributionWeeks(githubUsername);
const contributionTotal = contributionWeeks
  .flat()
  .reduce((total, day) => total + (day?.count ?? 0), 0);

let wakaStats: WakaTimeStats | null = null;
let wakaAllTimeStats: WakaTimeAllTimeStats | null = null;
const wakaKey = import.meta.env.WAKATIME_API_KEY;
if (wakaKey) {
  const headers = { Authorization: `Basic ${btoa(wakaKey)}` };
  try {
    const response = await fetch(
      "https://wakatime.com/api/v1/users/current/stats/last_7_days",
      { headers, signal: AbortSignal.timeout(3500) },
    );
    if (response.ok) {
      const data = (await response.json()) as WakaTimeResponse;
      wakaStats = data.data ?? null;
    }
  } catch {
    wakaStats = null;
  }

  try {
    const response = await fetch(
      "https://wakatime.com/api/v1/users/current/all_time_since_today",
      { headers, signal: AbortSignal.timeout(3500) },
    );
    if (response.ok) {
      const data = (await response.json()) as WakaTimeAllTimeResponse;
      wakaAllTimeStats = data.data ?? null;
    }
  } catch {
    wakaAllTimeStats = null;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Crazygiscool's personal portfolio: a hobbyist making game plugins, desktop apps, language tools, and web projects for fun." />
    <meta name="theme-color" content="#0b1220" />
    <link rel="canonical" href="https://crazyg.is-a.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Hanken+Grotesk:wght@400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Crazygiscool's Portfolio</title>
  </head>
  <body>
    <div class="site-atmosphere" aria-hidden="true"></div>
    <main id="top">
      <header class="hero page-shell">
        <div class="hero-activity-backdrop" role="group" aria-label="GitHub contribution chart moving behind the introduction">
          <div class="contribution-track">
            {Array.from({ length: 4 }, (_, copyIndex) => (
              <div
                class="native-contribution-chart"
                role={copyIndex === 0 ? "img" : undefined}
                aria-label={copyIndex === 0 ? "GitHub's native contribution graph. Hover a day to see its exact count and date." : undefined}
                aria-hidden={copyIndex === 0 ? undefined : "true"}
              >
                {contributionWeeks.map((week) => (
                  <div class="contribution-week">
                    {week.map((day) => day ? (
                      <span
                        class="native-contribution-day"
                        data-level={day.level}
                        title={`${day.count} ${day.count === 1 ? "contribution" : "contributions"} on ${day.date}`}
                        aria-label={`${day.count} contributions on ${day.date}`}
                        aria-hidden="true"
                      ></span>
                    ) : (
                      <span class="native-contribution-empty" aria-hidden="true"></span>
                    ))}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>

        <div class="hero-copy">
          <div class="availability"><span class="availability-dot"></span><span class="availability-copy">Hobbyist <span class="availability-divider">/</span> here for fun</span></div>
          <p class="hero-kicker">Making things <span>·</span> learning as I go</p>
          <h1>Making things<br /><span>just for fun.</span></h1>
          <p class="hero-description">
            I build little tools, game projects, desktop apps, and whatever else catches my attention. Mostly here to learn by making.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">
              Browse my projects
              <ArrowDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </a>
            <a class="social-link" href={githubProfileUrl} target="_blank" rel="noreferrer" aria-label="GitHub profile">
              <GitBranch size={19} strokeWidth={1.8} aria-hidden="true" />
            </a>
            <a class="social-link social-link-youtube" href="https://youtube.com/@crazygiscool" target="_blank" rel="noreferrer" aria-label="YouTube channel">
              <Video size={19} strokeWidth={1.8} aria-hidden="true" />
            </a>
            <a class="social-link" href="mailto:crazygiscool@proton.me" aria-label="Send email">
              <Mail size={18} strokeWidth={1.8} aria-hidden="true" />
            </a>
          </div>
          <div class="hero-footnote"> GAMES <i></i> LITTLE TOOLS <i></i> SIDE PROJECTS</div>
        </div>

        <div class="hero-visual">
          <a class="avatar-frame" href={githubProfileUrl} target="_blank" rel="noreferrer" aria-label={`Open ${githubUsername}'s GitHub profile`}>
            <img src={avatarUrl} alt="" width="144" height="144" fetchpriority="high" />
            <span class="avatar-ring" aria-hidden="true"></span>
          </a>
        </div>
      </header>

      <section class="work-section page-shell" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">01 / PROJECTS</p>
            <h2 id="work-title">A little bit of everything.</h2>
          </div>
        </div>
        <div class="project-grid">
          {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
        </div>
      </section>

      <section class="expertise-section page-shell" id="skills" aria-labelledby="skills-title">
        <div class="section-heading section-heading-compact">
          <div>
            <p class="section-eyebrow">02 / SKILLS &amp; TOOLS</p>
            <h2 id="skills-title">A snapshot of my GitHub.</h2>
          </div>
          <p class="section-aside">Languages and tools pulled<br />from my GitHub projects.</p>
        </div>
        <SkillsTools languages={githubLanguages} tools={githubTools} />
      </section>

      <ActivityPanel contributionTotal={contributionTotal} wakaStats={wakaStats} wakaAllTimeStats={wakaAllTimeStats} />

      <section class="contact-section page-shell" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="section-eyebrow">04 / SAY HELLO</p>
          <h2 id="contact-title">Let's talk about a project.</h2>
          <p>Or just send me something cool you found.</p>
        </div>
        <a class="contact-cta" href="mailto:crazygiscool@proton.me">
          <span>crazygiscool@proton.me</span>
          <span class="contact-cta-icon"><ArrowUpRight size={18} strokeWidth={1.8} aria-hidden="true" /></span>
        </a>
      </section>
    </main>

    <footer class="footer page-shell">
      <a class="footer-mark" href="#top" aria-label="Back to top"><img src={avatarUrl} alt="" width="26" height="26" /></a>
      <span>Made for fun.</span>
      <span class="footer-right">CRAZYGISCOOL <i></i> {new Date().getFullYear()}</span>
    </footer>
    <BottomDock avatarUrl={avatarUrl} />
  </body>
</html>
